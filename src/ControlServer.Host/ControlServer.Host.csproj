<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControlServer.Application\ControlServer.Application.csproj" />
    <ProjectReference Include="..\ControlServer.Domain\ControlServer.Domain.csproj" />
    <ProjectReference Include="..\ControlServer.Infrastructure\ControlServer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- control-server#80: the dashboard's two escalation thresholds, in a file of their own. -->
    <None Update="blocked-journey-escalation.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- control-server#142: the expected-action-overdue threshold the dashboard derives waiting time from. -->
    <None Update="expected-action-overdue.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

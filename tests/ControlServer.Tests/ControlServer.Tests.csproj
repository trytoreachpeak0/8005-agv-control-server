<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- FakeRiotTests starts the fake RIoT's real Kestrel, so this project needs the ASP.NET Core
         shared framework directly; a reference to a Web SDK project does not carry it across. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlServer.Dashboard\ControlServer.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Domain\ControlServer.Domain.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Host\ControlServer.Host.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Infrastructure\ControlServer.Infrastructure.csproj" />
    <!-- ControlServer.FieldOps is the second process writing the server's database, so
         SlotConfigurationVersionLineArchitectureTests scans its assembly alongside src/. -->
    <ProjectReference Include="..\..\tools\ControlServer.FieldOps\ControlServer.FieldOps.csproj" />
    <ProjectReference Include="..\..\tools\ControlServer.FakeRiot\ControlServer.FakeRiot.csproj" />
    <!-- FakeOnboardSlotStateSeedTests reads the synthetic peer's slot state seed (control-server#71). -->
    <ProjectReference Include="..\..\tools\ControlServer.FakeOnboard\ControlServer.FakeOnboard.csproj" />
    <ProjectReference Include="..\..\tools\ControlServer.ClockSkewProxy\ControlServer.ClockSkewProxy.csproj" />
    <ProjectReference Include="..\..\tools\ControlServer.ProtocolFaultProxy\ControlServer.ProtocolFaultProxy.csproj" />
    <!-- Build order only: SchemaConformanceToolTests runs this validator as its own process. Never let
         its assembly in here: its System.Text.Json 10 would replace the product's 8.0 one, and the
         gate would then be checking lines produced by a serializer production never runs. -->
    <ProjectReference Include="..\..\tools\ControlServer.SchemaConformance\ControlServer.SchemaConformance.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Where the build put that validator. Threaded through an assembly attribute rather than derived
         from this assembly's own path, which carries a configuration, a target framework and a RID
         that the test would have to guess. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ControlServer.SchemaConformance.Path</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)\..\..\tools\ControlServer.SchemaConformance\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\ControlServer.SchemaConformance.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

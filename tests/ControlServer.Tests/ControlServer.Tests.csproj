<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- FakeRiotTests starts the fake RIoT's real Kestrel, so this project needs the ASP.NET Core
         shared framework directly; a reference to a Web SDK project does not carry it across. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlServer.Dashboard\ControlServer.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Domain\ControlServer.Domain.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Host\ControlServer.Host.csproj" />
    <ProjectReference Include="..\..\src\ControlServer.Infrastructure\ControlServer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\tools\ControlServer.FakeRiot\ControlServer.FakeRiot.csproj" />
    <ProjectReference Include="..\..\tools\ControlServer.ClockSkewProxy\ControlServer.ClockSkewProxy.csproj" />
    <!-- Build order only: OutboundSchemaConformance runs this validator as its own process. Never let
         its assembly in here: its System.Text.Json 10 would replace the product's 8.0 one. -->
    <ProjectReference Include="..\..\tools\ControlServer.SchemaConformance\ControlServer.SchemaConformance.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

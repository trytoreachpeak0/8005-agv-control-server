+++ utc-new-inj.ps1	2026-10-08 10:51:18.418122100 +0800
@@ -38,6 +38,35 @@
 $journal = $Context.Journal
 $assertions = $Context.Assertions
 $connection = $Context.Connection
+
+# --- control-server#510 evidence only, never committed: hold the probe between its first and second read until the
+# server's commit is visible on another connection -- the timing CI run 37595371819 hit by chance, made certain. Once.
+$script:cs510Injected = $false
+function Wait-Cs510CommitElsewhere([string]$Sql) {
+    if ($script:cs510Injected) { return }
+    $script:cs510Injected = $true
+    $other = [Microsoft.Data.Sqlite.SqliteConnection]::new("Data Source=$($connection.DataSource);Mode=ReadOnly;Pooling=False")
+    $other.Open()
+    try {
+        $deadline = [DateTimeOffset]::UtcNow.AddSeconds(30)
+        while ([DateTimeOffset]::UtcNow -lt $deadline) {
+            $command = $other.CreateCommand()
+            $command.CommandText = $Sql
+            $n = [int]$command.ExecuteScalar()
+            $command.Dispose()
+            if ($n -gt 0) {
+                $journal.Note("CS510_INJECTION_FIRED: held between the first and second read until [$Sql] > 0")
+                Write-Host 'CS510_INJECTION_FIRED'
+                return
+            }
+            Start-Sleep -Milliseconds 50
+        }
+        $journal.Note("CS510_INJECTION_TIMED_OUT: [$Sql]")
+        Write-Host 'CS510_INJECTION_TIMED_OUT'
+    } finally {
+        $other.Dispose()
+    }
+}
 $riot = $Context.Riot
 $onboard = $Context.Onboard
 

FROM "JourneyDemands" AS "j"
WHERE EXISTS (
    SELECT 1
    FROM "AcceptedDemands" AS "a"
    WHERE "a"."Status" NOT IN ('Succeeded', 'Cancelled') AND NOT EXISTS (
        SELECT 1
        FROM "JourneyDemands" AS "j0"
        WHERE "j0"."DemandId" = "a"."DemandId" AND "j0"."RemovedAt" IS NULL) AND EXISTS (
        SELECT 1
        FROM "JourneyDemands" AS "j1"
        WHERE "j1"."DemandId" = "a"."DemandId" AND "j1"."RemovedAt" IS NOT NULL AND "j1"."RemovalReason" = 'RELEASED_FOR_REDISPATCH' AND NOT EXISTS (
            SELECT 1
            FROM "JourneyDemands" AS "j2"
            WHERE "j2"."DemandId" = "a"."DemandId" AND "j2"."DispatchGeneration" > "j1"."DispatchGeneration")) AND "a"."DemandId" = "j"."DemandId")
GROUP BY "j"."DemandId"

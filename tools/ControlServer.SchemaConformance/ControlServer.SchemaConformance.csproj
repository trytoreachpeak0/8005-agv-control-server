<Project Sdk="Microsoft.NET.Sdk">
  <!-- A separate process, never a referenced library. Corvus.Json.Validator 4.6.7 brings
       System.Text.Json 10.x and Roslyn; loaded into the test host, that System.Text.Json would
       replace the 8.0 one the product ships with, and every test would then measure a serializer
       production never runs. PrivateAssets keeps the package out of any referencing project's
       dependency graph as well. The test project references this one for build order only
       (ReferenceOutputAssembly="false"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Corvus.Json.Validator" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlServer.Domain\ControlServer.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract is read from the one vendored copy the repository holds, copied next to the
         executable at build time. There is no second copy of the manifest or the schemas in the
         repository, and the copy is checked against ProtocolCandidateIdentity on every run. -->
    <None Include="..\..\vendor\8005-agv-protocol\manifest\release.json" LinkBase="vendor\8005-agv-protocol\manifest\" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\8005-agv-protocol\schemas\**\*.json" LinkBase="vendor\8005-agv-protocol\schemas\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

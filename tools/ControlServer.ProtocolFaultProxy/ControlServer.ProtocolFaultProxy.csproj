<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControlServer.TestDoubles\ControlServer.TestDoubles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Deliberately no appsettings.json, for the reason ControlServer.FakeRiot's csproj records:
         it would land in the output of every project referencing this one and shadow the Host's
         own file. Configure with command-line switches; see README.md. -->
    <None Update="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

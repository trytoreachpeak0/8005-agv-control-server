<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately no appsettings.json. FakeRiotSeed already carries the 2026-09-03 field values
         as its defaults, and a second copy in a file would be a second truth to keep in step. It
         would also land in the output of every project that references this one, where it would
         shadow the Host's own appsettings.json. Configure with command-line switches or
         environment variables instead; see README.md. -->
    <None Update="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
